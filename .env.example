# Copy to .env for local use. Never enable test mode on a hosted deployment.
APP_MODE=test
APP_URL=http://localhost:3000
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_TEXT_MODEL=gpt-4.1-mini
RESEND_API_KEY=
MAIL_FROM=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Required in production: 32 random bytes encoded as 64 hexadecimal characters.
APP_ENCRYPTION_KEY=
